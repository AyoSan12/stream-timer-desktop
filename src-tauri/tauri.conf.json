{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Timer",
  "version": "1.0.1",
  "identifier": "app.streamtimer.desktop",
  "build": {
    "frontendDist": "../ui-boot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stream Timer",
        "width": 1280,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0b0d",
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine": "engine",
      "../ui": "ui"
    }
  }
}
